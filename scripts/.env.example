# ArbiShield Deployment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# =============================================================================
# Network Configuration
# =============================================================================

# Network to deploy to: sepolia, mainnet
NETWORK=sepolia

# =============================================================================
# Arbitrum Sepolia Testnet
# =============================================================================

# Arbitrum Sepolia RPC URL
# Get free RPC from: https://chainlist.org/?search=arbitrum+sepolia
SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Your private key (without 0x prefix)
# WARNING: Never use mainnet private key on testnet!
SEPOLIA_PRIVATE_KEY=your_private_key_here

# Arbiscan API key for contract verification
# Get from: https://arbiscan.io/myapikey
ARBISCAN_API_KEY=your_arbiscan_api_key

# =============================================================================
# Arbitrum Mainnet (for future production deployment)
# =============================================================================

# Arbitrum One RPC URL
MAINNET_RPC_URL=https://arb1.arbitrum.io/rpc

# Mainnet private key (KEEP SECURE!)
MAINNET_PRIVATE_KEY=

# =============================================================================
# Deployment Parameters
# =============================================================================

# Initial owner address (defaults to deployer if not set)
OWNER_ADDRESS=

# Initial admin address for AlertRegistry
ADMIN_ADDRESS=

# Initial monitor address for AlertRegistry
MONITOR_ADDRESS=

# DetectionEngine address (can be set after deployment)
DETECTION_ENGINE_ADDRESS=

# Gas price multiplier (1.0 = no multiplier, 1.5 = 50% higher)
GAS_PRICE_MULTIPLIER=1.2

# Max gas limit for deployment transactions
MAX_GAS_LIMIT=10000000

# =============================================================================
# Contract Configuration
# =============================================================================

# AlertRegistry: Default alert expiration (in seconds)
# Default: 2592000 (30 days)
DEFAULT_ALERT_EXPIRATION=2592000

# DetectionEngine: Default anomaly threshold
DEFAULT_ANOMALY_THRESHOLD=100

# =============================================================================
# Deployment Options
# =============================================================================

# Auto-verify contracts on Arbiscan (true/false)
AUTO_VERIFY=true

# Save deployment addresses to file (true/false)
SAVE_ADDRESSES=true

# Run post-deployment tests (true/false)
RUN_POST_DEPLOY_TESTS=true

# Enable deployment logging (true/false)
ENABLE_LOGGING=true

# Log file path
LOG_FILE=./scripts/logs/deployment.log

# =============================================================================
# Advanced Options
# =============================================================================

# Transaction confirmation blocks to wait
CONFIRMATION_BLOCKS=3

# Retry failed transactions (max attempts)
MAX_RETRY_ATTEMPTS=3

# Delay between retries (seconds)
RETRY_DELAY=10

# Enable dry run mode (simulate without deploying)
DRY_RUN=false
